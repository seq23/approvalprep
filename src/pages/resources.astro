---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustAndBoundaryBand from "../components/TrustAndBoundaryBand.astro";
import RecommendationSummary from "../components/RecommendationSummary.astro";
import RouteFaq from "../components/RouteFaq.astro";
import { faqSchema } from "../lib/schema";
import { routeAnswers } from "../lib/routeAnswers";
import { routeCopy, kitCount } from "../data/content";
const copy = routeCopy["/resources"];
// Published answers written about /resources, previously reachable only on
// their own /blog/ pages. One list feeds both the block and the schema.
const faq = routeAnswers("/resources");
---
<BaseLayout title="ApprovalPrep Resources: Guides, Policies, and Glossary" description="Find ApprovalPrep guides, short answers, how the kits are made, the glossary, prices and every policy page, organized by the question you are trying to answer." canonical="https://approvalprep.com/resources" schema={faq.length ? [faqSchema(faq.map((i) => ({ question: i.question, answer: i.answer })))] : []}>
  <section class="hero shell">
    <p class="eyebrow">Resources</p>
    <h1>Find the guide, answer or policy that matches your question.</h1>
    <p class="lead">Draft a letter free, compare the kits, read a guide, or check what ApprovalPrep does and does not do.</p>
    <div class="hero-actions">
      <a class="button primary-button" href="/letter-writing-studio/">Draft free in the Letter Studio</a>
      <a class="button secondary-button" href="/blog/">Read the short answers</a>
    </div>
  </section>
  {/* recommendation_summary: this page's own copy record in src/data/content.ts
      states what it points users to. Nothing here is composed for the block. */}
  <section class="band recommendation-summary-band"><div class="shell">
    <RecommendationSummary statement={copy.shortAnswer} />
  </div></section>
  <section class="band"><div class="shell">
    <p class="eyebrow">Resource paths</p>
    <h2>Choose the kind of help you need.</h2>
    <div class="resource-grid">
      <a class="card resource-card" href="/blog/"><span>Short answers</span><h3>ApprovalPrep answers</h3><p>Plain answers to common paperwork questions, each with the guide or kit that goes with it.</p></a>
      <a class="card resource-card" href="/methodology/"><span>How it works</span><h3>Methodology</h3><p>How the kits are made: true facts, supporting documents, a review step, and what ApprovalPrep does not do.</p></a>
      <a class="card resource-card" href="/glossary/"><span>Definitions</span><h3>Glossary</h3><p>Plain-language definitions for document prep, explanation letters, packets, and self-service boundaries.</p></a>
      <a class="card resource-card" href="/pricing/"><span>Buying help</span><h3>Compare kits</h3><p>{`See the ${kitCount} kits and the Complete Bundle, with prices and what is inside each.`}</p></a>
      <a class="card resource-card" href="/privacy/"><span>Privacy</span><h3>Privacy and no-storage policy</h3><p>Understand what ApprovalPrep stores, what it does not store, and how the free Studio stays browser-only.</p></a>
      <a class="card resource-card" href="/disclaimer/"><span>What we do not do</span><h3>Disclaimers</h3><p>ApprovalPrep is not credit repair or legal advice, and it cannot promise an approval. Read this before using a kit.</p></a>
    </div>
  </div></section>
  <section class="band"><div class="shell">
    <p class="eyebrow">Browse a whole section</p>
    <h2>Open the full index for a section instead of one page from it.</h2>
    <div class="resource-grid">
      <a class="card resource-card" href="/tools/"><span>Section index</span><h3>Free ApprovalPrep Document Checklists</h3><p>All six free checklists, one for each application situation, with the matching kit named on each.</p></a>
      <a class="card resource-card" href="/templates/"><span>Section index</span><h3>ApprovalPrep Letter Template Previews</h3><p>All five public previews showing how each ApprovalPrep letter is structured before you buy the editable file.</p></a>
      <a class="card resource-card" href="/reports/"><span>Section index</span><h3>ApprovalPrep Public Reports</h3><p>All three public reports, each with its own method, its sources, and what it does not claim.</p></a>
    </div>
  </div></section>

  <section class="band"><div class="shell">
    <p class="eyebrow">Free to use</p>
    <h2>Free tools and template previews.</h2>
    <div class="resource-grid">
      <a class="card resource-card" href="/tools/apartment-application-readiness-checklist/"><span>Tool</span><h3>Apartment readiness checklist</h3><p>Prepare the documents and facts reviewers usually ask for before you apply.</p></a>
      <a class="card resource-card" href="/tools/proof-of-income-packet-checklist/"><span>Tool</span><h3>Proof of income packet checklist</h3><p>Organize income proof, dates, source details, and review notes before sending anything.</p></a>
      <a class="card resource-card" href="/letter-of-explanation/employment-gap/"><span>Template</span><h3>Employment gap explanation preview</h3><p>See how the letter is laid out before buying the editable kit.</p></a>
      <a class="card resource-card" href="/rental-application/cover-letter/"><span>Template</span><h3>Rental application cover letter preview</h3><p>See what the free preview covers and what the paid kit adds.</p></a>
    </div>
  </div></section>

  <section class="band"><div class="shell">
    <p class="eyebrow">Public reports</p>
    <h2>Reports, each with its method and sources.</h2>
    <div class="resource-grid">
      <a class="card resource-card" href="/reports/document-readiness-index/"><span>Report</span><h3>Document readiness report</h3><p>What a ready set of documents looks like, and how the report was put together.</p></a>
      <a class="card resource-card" href="/how-to-get-approved-for-an-apartment/"><span>Report</span><h3>Apartment application prep report</h3><p>Review the rental packet readiness areas before applying.</p></a>
      <a class="card resource-card" href="/business-loan-documents/"><span>Report</span><h3>Business funding document prep report</h3><p>Organize business funding documents before you apply. This is not lending advice.</p></a>
    </div>
  </div></section>
  <RouteFaq items={faq} heading="Questions people ask about ApprovalPrep resources" />
  <TrustAndBoundaryBand />
</BaseLayout>
