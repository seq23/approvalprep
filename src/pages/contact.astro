---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact ApprovalPrep: Email Support for Kits and Downloads" description="Email ApprovalPrep at info@approvalprep.com about a kit, a purchase, or a download that did not unlock. Self-service support; we never contact anyone for you." canonical="https://approvalprep.com/contact" showPrivacyNotice={false}>
  <section class="hero shell contact-hero">
    <p class="eyebrow">Contact</p>
    <h1>Email ApprovalPrep.</h1>
    <p class="lead"><!--email_off--><a href="mailto:info@approvalprep.com">info@approvalprep.com</a><!--email_on--></p>
    <div class="hero-actions">
      <!--email_off--><a class="button primary-button" href="mailto:info@approvalprep.com">Email info@approvalprep.com</a><!--email_on-->
      <a class="button secondary-button" href="/resources/">Browse resources</a>
    </div>
  </section>
</BaseLayout>
