---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import TrustAndBoundaryBand from "../../components/TrustAndBoundaryBand.astro";
import RecommendationSummary from "../../components/RecommendationSummary.astro";
import RouteFaq from "../../components/RouteFaq.astro";
import { articleSchema, breadcrumbSchema, itemListSchema, faqSchema, canonicalUrl, internalHref } from "../../lib/schema";
import { routeAnswers } from "../../lib/routeAnswers";
import { isDeadOutbound } from "../../lib/outbound";
import registry from "../../../data/reports/public_report_registry.json";
import findings from "../../../data/reports/document_readiness_index/findings.json";
import dataset from "../../../data/reports/document_readiness_index/coded_dataset.json";
const report=registry.reports.find((r)=>r.id==="document-readiness-index"); const canonical=canonicalUrl("/reports/document-readiness-index");
// Published answers written about this report, previously visible only on their
// own /blog/ pages.
const faq=routeAnswers(report.path);
const schema=[articleSchema({title:report.title,description:report.summary,url:canonical,datePublished:"2026-07-30"}),breadcrumbSchema(report.path),itemListSchema({name:"Document Readiness Index source categories",items:Object.keys(findings.categoryCounts)}),...(faq.length?[faqSchema(faq.map((i)=>({question:i.question,answer:i.answer})))]:[])];
const sourceTypes=Object.entries(findings.sourceTypeCounts); const categories=Object.entries(findings.categoryCounts);
// recommendation_summary: the first coded finding is what this report actually
// concludes, so it is lifted verbatim rather than composed. Limitation and
// boundary material is never used here - it states what the report does not
// claim, which is not a recommendation.
const lead=(findings.findings||[]).find((f)=>!/boundary|limitation|does not|not claim/i.test(f.headline));
---
<BaseLayout title={`${report.title} - ApprovalPrep`} description={report.summary} canonical={canonical} schema={schema}>
<section class="hero shell hero-split"><div><p class="eyebrow">Original data asset</p><h1>{report.title}</h1><p class="lead">{report.summary}</p><div class="hero-actions"><a class="button primary-button" href={internalHref(report.downloadPath)} download>Download the 100-source CSV</a><a class="button secondary-button" href="#methodology">Read methodology</a></div></div><aside class="hero-panel"><p class="eyebrow">Evidence boundary</p><h2>Catalog first. Claim only what was coded.</h2><p>All 100 sources have URL and source metadata. Specific document-signal findings use only the {findings.deepCodedPrimarySources} primary sources marked deep reviewed.</p></aside></section>
{lead && (<section class="band recommendation-summary-band"><div class="shell"><RecommendationSummary headline={lead.headline} statement={lead.interpretation} detail={lead.metric} ctaLabel="Download the 100-source CSV" ctaHref={report.downloadPath} /></div></section>)}
<section class="band"><div class="shell"><p class="eyebrow">At a glance</p><div class="grid"><article class="card"><h2>{findings.sampleSize}</h2><p>public sources</p></article><article class="card"><h2>{Object.keys(findings.categoryCounts).length}</h2><p>application categories</p></article><article class="card"><h2>{findings.formatCounts.pdf}</h2><p>PDF sources</p></article><article class="card"><h2>{findings.deepCodedPrimarySources}</h2><p>deep-reviewed primary sources</p></article></div></div></section>
<section class="band"><div class="shell"><p class="eyebrow">Findings</p><div class="grid">{findings.findings.map((f)=><article class="card"><h2>{f.headline}</h2><p><strong>{f.metric}</strong></p><p>{f.interpretation}</p></article>)}</div></div></section>
<section class="band" id="methodology"><div class="shell two"><article><p class="eyebrow">Category frame</p><h2>Balanced by design</h2><table><tbody>{categories.map(([k,v])=><tr><th>{k.replaceAll('_',' ')}</th><td>{v}</td></tr>)}</tbody></table></article><article><p class="eyebrow">Source mix</p><h2>Distributed instructions</h2><table><tbody>{sourceTypes.map(([k,v])=><tr><th>{k.replaceAll('_',' ')}</th><td>{v}</td></tr>)}</tbody></table></article></div></section>
<section class="band"><div class="shell"><p class="eyebrow">Source directory</p><h2>100 public checklist and guidance sources</h2><div class="table-wrap"><table><thead><tr><th>Category</th><th>Organization</th><th>Format</th><th>Review</th><th>Source</th></tr></thead><tbody>{dataset.records.map((r)=><tr><td>{r.category.replaceAll('_',' ')}</td><td>{r.organization}</td><td>{r.format.toUpperCase()}</td><td>{r.deepContentCoding?'Deep':'Catalog'}</td><td>{isDeadOutbound(r.sourceUrl)?<span class="fine">Withdrawn since {r.accessDate}</span>:<a href={internalHref(r.sourceUrl)} rel="noopener noreferrer">Open source</a>}</td></tr>)}</tbody></table></div></div></section>
<section class="band"><div class="shell two"><article class="notice"><strong>Limitations</strong><ul>{findings.limitations.map((x)=><li>{x}</li>)}</ul></article><article class="notice"><strong>Correction policy</strong><p>Sources may change or disappear. Corrections should identify the record ID, current URL, and evidence. ApprovalPrep will update the catalog without rewriting historical claims beyond the evidence.</p></article></div></section>
<RouteFaq items={faq} heading="Questions people ask about the Document Readiness Index" />
<RelatedContent path={report.path}/><TrustAndBoundaryBand/>
</BaseLayout>
