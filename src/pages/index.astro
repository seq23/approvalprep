---
import { internalHref, canonicalUrl, websiteSchema, speakableWebPageSchema, faqSchema } from "../lib/schema";
import DemandGuideLinks from "../components/DemandGuideLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import BoundaryNotice from "../components/BoundaryNotice.astro";
import TrustBar from "../components/TrustBar.astro";
import HowItWorks from "../components/HowItWorks.astro";
import UseCaseList from "../components/UseCaseList.astro";
import WhatYouGet from "../components/WhatYouGet.astro";
import FinalCTA from "../components/FinalCTA.astro";
import CreditBoundaryExplainer from "../components/CreditBoundaryExplainer.astro";
import NextStepsExplainer from "../components/NextStepsExplainer.astro";
import DataPrivacyNotice from "../components/DataPrivacyNotice.astro";
import FreeStudioCTA from "../components/FreeStudioCTA.astro";
import RecommendationSummary from "../components/RecommendationSummary.astro";
import OfferingUniverse from "../components/OfferingUniverse.astro";
import { trustSignals, howItWorks, whyApprovalPrep, homepageChooser, productComparison, offeringCategories } from "../data/content";
// 65 characters is the ceiling (src/lib/title.mjs): this ran 67 with the brand
// twice over, once as the lead word and once inside the phrase. The query leads
// now and the site name appears once, as the suffix every other page carries.
const pageTitle = "Self-Service Credit Repair Letters - ApprovalPrep";
const pageDescription = "Download self-service credit repair letters, explanation letters, rental packets, income proof templates, and approval-prep document kits. The DIY alternative to monthly credit repair.";
// Added 6 Nov 2026 (search and blue-ocean decision, https://claude.ai/artifact/JxZbRkaRbZfZrKEJpUMV6Y):
// the homepage had no FAQ. Every answer keeps to risk R-ADV-13: self-help only, no
// promise to remove items or change a score, accurate information stays. The one
// competitor price carries its source and the date it was read.
const CREDIT_SAINT_READ = "6 November 2026";
const homeFaq = [
  { question: "Is ApprovalPrep a credit repair company?", answer: "No. ApprovalPrep sells self-help letter templates. You write, review and send every letter yourself. We do not contact credit bureaus or creditors for you, and we do not act on your behalf." },
  { question: "Can I dispute my credit report myself for free?", answer: "Yes. You can dispute an error directly with the credit bureau and with the business that reported it. Federal law (the Fair Credit Reporting Act) requires the bureau to investigate your dispute free of charge. Our kits give you the letter wording and the steps; the free Letter Studio lets you draft a first version before you pay anything." },
  { question: "What does a credit repair company cost?", answer: `Credit Saint's own website listed plans from $79.99 to $139.99 a month, plus a first-work fee of $99 to $195, when we read it on ${CREDIT_SAINT_READ}. The ApprovalPrep Credit Letter Kit is $19, paid once.` },
  { question: "Will these letters remove items or raise my score?", answer: "We cannot promise that, and no template can. A letter is a request. Credit bureaus must look into a dispute, and information that is wrong or cannot be verified must be corrected or removed, but accurate information usually stays on your report." }
];
// The definition paragraph directly under the H1 is what an answer engine or a
// voice assistant should read for "what is ApprovalPrep". The speakable selector
// names it by id; scripts/validate/seo-hygiene.mjs (check `definition`) fails if
// the id stops resolving, the paragraph stops starting "ApprovalPrep is", or it
// leaves the 40-60 word band.
const homeSchema = [
  websiteSchema(),
  speakableWebPageSchema({ title: pageTitle, description: pageDescription, url: canonicalUrl("/"), cssSelector: ["h1", "#what-is-approvalprep"] }),
  faqSchema(homeFaq)
];
---
<BaseLayout title={pageTitle} description={pageDescription} schema={homeSchema}>
  <section class="hero hero-split shell">
    <div>
      <p class="eyebrow">DIY credit letters + approval paperwork</p>
      <h1>Self-service credit repair letters and approval-ready documents, <span class="ap-hl">without the high monthly fees.</span></h1>
      <p class="lead" id="what-is-approvalprep">ApprovalPrep is a self-service document prep site that sells one-time, direct-download kits of letters, checklists, and templates for credit report questions, goodwill letters, debt validation, rental applications, income proof, loan reviews, and letters of explanation. Each kit unlocks a PDF guide and an editable DOCX file; you fill in your true facts and send it yourself.</p>
      <p class="supporting-copy ap-alt-line">The do-it-yourself alternative to a monthly credit repair company: draft free, buy the letters once, send them yourself.</p>
      <div class="hero-actions ap-hero-actions">
        <a class="button primary-button" href={internalHref("/letter-writing-studio/")}>Draft free in the Letter Studio</a>
        <p class="ap-free-note">No account, no upload, no stored answers, and no payment.</p>
        <a class="button secondary secondary-button" href={internalHref("/pricing/#credit-letter-kit")}>Get DIY credit letters — $19</a>
        <a class="ap-textlink" href={internalHref("/pricing")}>Compare all kits and prices</a>
      </div>
      <div class="ap-sheet" role="img" aria-label="Example: the first lines of a dispute letter drafted in the Letter Studio">
        <p class="eyebrow">Example · your letter, first draft</p>
        <p>I am writing to dispute one item on my credit report.</p>
        <p><span class="ap-hl">[Account name] shows a 30-day late payment for [month and year].</span></p>
        <p>My records show it was paid on time. A copy is attached.</p>
      </div>
      <p class="ap-selfhelp">Self-help templates. Not legal or financial advice. We do not contact bureaus or creditors for you.</p>
      <TrustBar signals={trustSignals} />
    </div>
    <aside class="hero-panel" aria-label="ApprovalPrep process">
      <p class="eyebrow">Why people use it</p>
      <h2>Fix the paperwork story before it costs you the apartment, job, loan, or account.</h2>
      <ol class="compact-list">
        <li>Challenge possible credit report errors with your own prepared letters.</li>
        <li>Explain late payments, gaps, income changes, or address history clearly.</li>
        <li>Build a stronger rental, lender, employer, or funding packet before review.</li>
        <li>Pay once for the kit instead of starting an open-ended monthly service.</li>
      </ol>
      <div class="hero-actions">
        <a class="button primary-button" href="/pricing/">See kits from $15</a>
        <a class="button secondary-button" href="/letter-writing-studio/">Draft for $0 first</a>
      </div>
    </aside>
  </section>

  <section class="band ap-compare" id="company-or-yourself"><div class="shell">
    <p class="eyebrow">Before you sign up for a monthly plan</p>
    <h2>A credit repair company or doing it yourself?</h2>
    <div class="table-wrap"><table class="comparison-table ap-labelled"><thead><tr><th></th><th>Monthly credit repair company</th><th>Do it yourself with ApprovalPrep</th></tr></thead><tbody>
      <tr><th scope="row">What you pay</th><td data-label="Credit repair company">Credit Saint: $79.99 to $139.99 a month, plus a $99 to $195 first-work fee (<a href="https://www.creditsaint.com/" rel="nofollow noopener" target="_blank">its own site</a>, read {CREDIT_SAINT_READ}).</td><td data-label="Do it yourself">$19 once for the Credit Letter Kit. Drafting in the Letter Studio is free.</td></tr>
      <tr><th scope="row">Who sends the letters</th><td data-label="Credit repair company">The company, on your behalf.</td><td data-label="Do it yourself">You do. We never contact bureaus or creditors for you.</td></tr>
      <tr><th scope="row">What the law says</th><td data-label="Credit repair company">The Credit Repair Organizations Act bars a credit repair company from charging you before the promised work is done (<a href="https://www.law.cornell.edu/uscode/text/15/1679b" rel="noopener" target="_blank">15 U.S.C. 1679b</a>).</td><td data-label="Do it yourself">Disputing an error is free: the credit bureau must investigate it free of charge (<a href="https://www.law.cornell.edu/uscode/text/15/1681i" rel="noopener" target="_blank">15 U.S.C. 1681i</a>).</td></tr>
    </tbody></table></div>
    <p class="fine">Read more: <a href={internalHref("/not-a-credit-repair-company")}>why ApprovalPrep is not a credit repair company</a>. The full cost comparison page is <span class="ap-tag">planned</span>.</p>
  </div></section>

  {/* The hero's supporting line already stated what the site recommends doing.
      It is folded into the recommendation_summary block here rather than
      published in both places. */}
  <section class="band recommendation-summary-band"><div class="shell">
    <RecommendationSummary
      headline="Buy the kit, download the files, fill in your true facts, and send the paperwork yourself."
      statement="The free Studio is optional if you want to draft before you buy."
      ctaLabel="See kits from $15"
      ctaHref="/pricing"
    />
  </div></section>

  <section class="band path-choice-band" id="download-or-studio"><div class="shell">
    <p class="eyebrow">After checkout, you choose</p>
    <h2>Download the templates as-is, or use the Studio to fill a first draft.</h2>
    <p class="lead">Every paid kit unlocks two protected files: a PDF guide and an editable DOCX template kit. You are not forced to type private details before buying.</p>
    <div class="two path-choice-grid">
      <article class="card path-choice-card">
        <span class="step-number">1</span>
        <h3>Option A: Download now</h3>
        <ol class="compact-list">
          <li>Buy the kit that matches your situation.</li>
          <li>Download the PDF guide and editable DOCX file after Stripe verifies checkout.</li>
          <li>Open the DOCX, replace the placeholders with your true facts, review it, and send it yourself.</li>
        </ol>
        <a class="button primary-button" href="/pricing/">Compare kits</a>
      </article>
      <article class="card path-choice-card">
        <span class="step-number">2</span>
        <h3>Option B: Use the free Studio</h3>
        <ol class="compact-list">
          <li>Open the browser-only Letter Studio before or after purchase.</li>
          <li>Answer guided prompts to prefill a first-pass draft locally in your browser.</li>
          <li>Copy the draft into your editable DOCX, review it, and send only what is true.</li>
        </ol>
        <a class="button secondary-button" href="/letter-writing-studio/">Try our Letter Studio - Free!</a>
      </article>
    </div>
  </div></section>
  <section class="band" id="choose-path"><div class="shell">
    <p class="eyebrow">Choose by pressure point</p>
    <h2>What are you trying to get ready for?</h2>
    <p class="lead">People do not shop for paperwork. They shop for the next approval that paperwork can protect. Start with the situation, then buy the direct-download kit that matches it.</p>
    <div class="decision-grid">
      {homepageChooser.map((item) => (
        <a class="decision-card" href={internalHref(item.href)}>
          <span>{item.product}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
          <strong>{item.cta}</strong>
        </a>
      ))}
    </div>
  </div></section>
  <DemandGuideLinks all={true} eyebrow="Most-searched guides" heading="Start with the letter or form you were asked for." />
  <section class="ap-planned shell" aria-label="Guides being written">
    <p class="fine">Being written next <span class="ap-tag">planned</span>: debt validation letter · pay for delete letter · how to remove late payments from a credit report · how to remove hard inquiries.</p>
  </section>
  <FreeStudioCTA />
  <section class="band"><div class="shell">
    <p class="eyebrow">Compare kits</p>
    <h2>Not sure which one fits? Compare the common paths.</h2>
    <div class="table-wrap"><table class="comparison-table"><thead><tr><th>Product</th><th>Best for</th><th>Includes</th><th>Price</th></tr></thead><tbody>
      {productComparison.map((row) => <tr><td data-label="Product"><a href={internalHref(row.href)}>{row.product}</a></td><td data-label="Best for">{row.bestFor}</td><td data-label="Includes">{row.includes}</td><td data-label="Price"><strong>{row.price}</strong></td></tr>)}
    </tbody></table></div>
  </div></section>
  <section class="band"><div class="shell">
    <p class="eyebrow">30+ self-service documents. 8 direct-download kits.</p>
    <h2>Buy one kit, get the related letters and checklists together.</h2>
    <p class="lead">The offer is intentionally simple: you do not buy every letter one by one. Each paid kit bundles the letters, checklists, examples, and next steps for that paperwork lane, then unlocks as PDF + editable DOCX after checkout.</p>
    <OfferingUniverse categories={offeringCategories} variant="summary" />
  </div></section>
  <section class="band"><div class="shell"><p class="eyebrow">Products</p><h2>Choose the kit that matches the application pressure.</h2><ProductGrid /></div></section>
  <section class="band"><div class="shell"><HowItWorks steps={howItWorks} /></div></section>
  <section class="band"><div class="shell"><WhatYouGet title="Why ApprovalPrep" items={whyApprovalPrep} /></div></section>
  <section class="band"><div class="shell"><UseCaseList items={["You want self-service credit repair letters or credit explanation paperwork you can prepare and send yourself.", "You want to get apartment-ready, job-ready, loan-ready, or funding-ready before a reviewer asks for more documents.", "You want a lower-cost paperwork kit instead of an open-ended service, while keeping control of what you send and when."]} /></div></section>
  <section class="band"><div class="shell"><NextStepsExplainer /></div></section>
  <section class="band"><div class="shell"><DataPrivacyNotice /></div></section>
  <section class="band"><div class="shell"><CreditBoundaryExplainer /></div></section>
  <section class="band"><div class="shell"><BoundaryNotice /></div></section>
  <section class="band" id="faq" data-content-block="faq"><div class="shell">
    <p class="eyebrow">Questions</p>
    <h2>Questions about doing it yourself</h2>
    <div class="ap-faq">{homeFaq.map((item) => <article class="card"><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div>
    <p class="ap-selfhelp">Self-help templates. Not legal or financial advice. We do not contact bureaus or creditors for you.</p>
  </div></section>
  <FinalCTA primary="Start free for $0" secondary="Compare all kits" href="/letter-writing-studio/" secondaryHref="/pricing" />
</BaseLayout>
