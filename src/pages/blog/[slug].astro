---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoundaryNotice from "../../components/BoundaryNotice.astro";
import RecommendationSummary from "../../components/RecommendationSummary.astro";
import answersData from "../../../data/content/generated_answers.json";
import { articleSchema, breadcrumbSchema, faqSchema } from "../../lib/schema";

const slugify = (value) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 100);
export function getStaticPaths() {
  const toSlug = (value) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 100);
  return answersData.answers.filter((item) => item.status === "published_by_contract").map((answer) => ({ params: { slug: toSlug(answer.title) }, props: { answer } }));
}
const { answer } = Astro.props;
const slug = slugify(answer.title);
const canonical = `https://approvalprep.com/blog/${slug}`;
// Cut on a word boundary. slice(0, 155) alone ended these mid-word - "increase
// based on ac" - which is what a search result then shows.
const description = answer.answer.length <= 155
  ? answer.answer
  : `${answer.answer.slice(0, 155).replace(/\s+\S*$/, "")}...`;
const publishedAt = answer.publishedAt || answersData.generatedAt;
// FAQPage describes what this page is rather than being bolted onto it: the
// <h1> is the authored question and the lead paragraph directly beneath it is
// the authored answer, both from the same record. One pair, not padded with
// invented questions.
const schema = [
  articleSchema({ title: answer.title, description, url: canonical, datePublished: publishedAt }),
  faqSchema([{ question: answer.title, answer: answer.answer }]),
  breadcrumbSchema(`/blog/${slug}`)
];
---
<BaseLayout title={`${answer.title} - ApprovalPrep Blog`} description={description} canonical={canonical} schema={schema}>
  <section class="hero shell">
    <p class="eyebrow">Daily document-prep answer · {answer.riskLevel} risk</p>
    <h1>{answer.title}</h1>
    <p class="lead">{answer.answer}</p>
    <div class="hero-actions">
      <a class="button primary-button" href={answer.route}>Continue to related page</a>
      <a class="button secondary-button" href="/letter-writing-studio">Start free for $0</a>
    </div>
  </section>
  {/* The practical sequence is what this answer recommends doing, so it carries
      the recommendation_summary marking instead of being restated above it. An
      answer with no sequence gets no block. */}
  {answer.steps?.length > 0 && (
    <section class="band recommendation-summary-band"><div class="shell">
      <RecommendationSummary headline="Use this order before you send anything." points={answer.steps} ordered={true} ctaLabel="Open related ApprovalPrep page" ctaHref={answer.route} />
    </div></section>
  )}
  {answer.checklist?.length > 0 && (
    <section class="band"><div class="shell two">
      <article class="card">
        <p class="eyebrow">Review checklist</p>
        <h2>Check the packet for clarity and proof.</h2>
        <ul>{answer.checklist.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="card">
        <p class="eyebrow">Common mistakes</p>
        <h2>Remove avoidable friction.</h2>
        <ul>{(answer.commonMistakes || []).map((item) => <li>{item}</li>)}</ul>
      </article>
    </div></section>
  )}
  <section class="band"><div class="shell two">
    <article class="card">
      <p class="eyebrow">Self-service boundary</p>
      <h2>Use this as preparation, not representation.</h2>
      <p>{answer.boundary || "ApprovalPrep helps you organize truthful facts, supporting documents, and next steps. It does not contact third parties, create fake documents, provide legal or financial advice, repair credit, or promise approval."}</p>
    </article>
    <BoundaryNotice />
  </div></section>
  <section class="band"><div class="shell">
    <article class="notice">
      <strong>Related next step:</strong>
      <p>Use the related guide or product page to move from a short answer into a practical packet.</p>
      <a class="button secondary-button" href={answer.route}>Open related ApprovalPrep page</a>
    </article>
  </div></section>
</BaseLayout>
