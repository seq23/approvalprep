---
import { internalHref } from "../lib/schema";
import BaseLayout from "../layouts/BaseLayout.astro";
import answersData from "../../data/content/generated_answers.json";
import RecommendationSummary from "../components/RecommendationSummary.astro";
import { routeCopy } from "../data/content";
const copy = routeCopy["/blog"];
const published = answersData.answers.filter((item) => item.status === "published_by_contract");
const slugify = (value) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 100);
---
<BaseLayout title="ApprovalPrep Blog - Short Document Prep Answers" description="Short, plain answers about explanation letters, credit letters, rental application packets and income proof, each with the guide or kit that goes with it." canonical="https://approvalprep.com/blog">
  <section class="hero shell">
    <p class="eyebrow">Blog</p>
    <h1>Short answers to paperwork questions.</h1>
    <p class="lead">Plain answers about explanation letters, credit letters, rental packets and income proof. Each one links to the guide or kit that goes with it.</p>
    <div class="hero-actions">
      <a class="button primary-button" href="/letter-writing-studio/">Draft free in the Letter Studio</a>
      <a class="button secondary-button" href="/resources/">Browse all resources</a>
    </div>
  </section>
  {/* recommendation_summary: this hub's own copy record in src/data/content.ts
      states what it directs readers to. Nothing here is composed for the block. */}
  <section class="band recommendation-summary-band"><div class="shell">
    <RecommendationSummary statement={copy.shortAnswer} ctaLabel="Draft free in the Letter Studio" ctaHref="/letter-writing-studio" />
  </div></section>
  <section class="band"><div class="shell">
    <div class="publishing-header">
      <div>
        <p class="eyebrow">Published answers</p>
        <h2>{`${published.length} answers to read now.`}</h2>
        <p class="lead">Each answer has its own page and links to the guide or kit that goes with it.</p>
      </div>
    </div>
    <div class="blog-list">
      {published.map((item) => (
        <article class="card blog-card">
                    <h3>{item.title}</h3>
          <p>{item.answer}</p>
          <div class="hero-actions"><a class="button primary-button" href={internalHref(`/blog/${slugify(item.title)}`)}>Read the answer</a><a class="button secondary-button" href={internalHref(item.route)}>Related page</a></div>
        </article>
      ))}
    </div>
  </div></section>
</BaseLayout>
