---
// The free Letter Studio. Everything runs in the reader's browser: the letter is built by
// src/lib/letterStudioCore.mjs and the dispute letter's PDF by src/lib/letterPdf.mjs. No network
// call, no upload; the draft is kept in this browser tab's sessionStorage so a reload does not
// lose it. `data-no-session-recording` keeps the session recorder off this page
// (scripts/install_clarity.mjs), so "nothing you type is sent to us" stays true.
import { studioSituations, bureaus, kitMoments, SELF_HELP_LINE, TRUE_FACTS_LINE, BUREAU_ADDRESSES_CHECKED, ANSWER_WINDOW, BEFORE_YOU_MAIL } from "../data/letterStudio";
const creditKit = productForSku("credit-letter-kit");
const creditKitLabel = `${creditKit?.name || "Credit Letter Kit"} — ${creditKit?.priceLabel || "$19"}`;
import { productForSku } from "../data/content";
const kits = Object.fromEntries(studioSituations.map((s) => {
  const product = productForSku(s.recommendationSku);
  return [s.id, { name: product?.name || s.recommendationName, price: product?.priceLabel || "", sku: s.recommendationSku, ...kitMoments[s.recommendationSku] }];
}));
const first = studioSituations[0];
---
<section class="studio-shell" data-letter-studio data-no-session-recording data-kits={JSON.stringify(kits)}>
  <div class="studio-grid">
    <form class="card studio-form" novalidate>
      <p class="eyebrow">Step 1 · Your facts</p>
      <h2>Choose the situation.</h2>
      <label>
        Situation
        <select name="situation">
          {studioSituations.map((item) => <option value={item.id}>{item.label}</option>)}
        </select>
      </label>
      <p class="fine">{TRUE_FACTS_LINE}</p>
      <div class="studio-fields" data-fields></div>
      <button class="button primary-button" type="submit" data-generate-draft>Write my letter</button>
      <p class="fine">Nothing you type is sent to us. Your draft is kept in this browser tab only, so a reload does not lose it; it is gone when you close the tab or start over.</p>
      <p class="studio-quiet"><button class="link-button" type="button" data-reset-studio>Start over</button><span data-undo hidden> Cleared. <button class="link-button" type="button" data-undo-reset>Undo ›</button></span></p>
    </form>
    <aside class="card studio-preview" id="your-letter">
      <p class="eyebrow">Step 2 · Your letter</p>
      <h2>Your first-pass letter</h2>
      <p class="studio-status" role="status" aria-live="polite" data-status>Answer the questions, then press “Write my letter ›”. Your letter appears here.</p>
      <div class="ap-sheet letter-sheet" data-draft-output hidden></div>
      <div class="hero-actions" data-letter-actions hidden>
        <button class="button secondary-button" type="button" data-save-pdf hidden>Save as PDF</button>
        <button class="button secondary-button" type="button" data-copy-draft>Copy letter</button>
        <button class="button secondary-button" type="button" data-share-draft hidden>Share</button>
        <button class="link-button" type="button" data-download-draft>Save as a text file</button>
      </div>
      <div class="notice" data-mail-steps hidden>
        <strong>Before you mail it</strong>
        <ol class="compact-list">
          {BEFORE_YOU_MAIL.map((line) => <li>{line}</li>)}
        </ol>
        <p class="fine">The PDF carries this list as page 2. Mail addresses read {BUREAU_ADDRESSES_CHECKED} from <a href={bureaus[0].source.url} rel="noopener">Equifax</a>, <a href={bureaus[1].source.url} rel="noopener">Experian</a> and the <a href={bureaus[2].source.url} rel="noopener">FTC</a> (TransUnion).</p>
      </div>
      <div class="recommendation-card studio-timeline" data-timeline hidden>
        <p class="eyebrow">What happens next</p>
        <ol class="timeline-list">
          <li><strong>Today</strong><span>Print it, sign it and mail it yourself with your proof.</span></li>
          <li><strong>The answer is due about <span data-due-date>30 days after you mail it</span></strong>
            <label class="mailed-on">Mailed on <input type="date" name="mailedOn" data-mailed-on /></label>
            <span>{ANSWER_WINDOW.text} Sources: <a href={ANSWER_WINDOW.source.url} rel="noopener">FTC</a>, <a href={ANSWER_WINDOW.law.url} rel="noopener">{ANSWER_WINDOW.law.label}</a> (read 10 Nov 2026). What the bureau decides is up to the bureau.</span>
            <button class="button secondary-button" type="button" data-add-calendar>Add the date to my calendar</button>
            <span class="fine">The date is yours to keep. We send no reminder and store nothing.</span>
            <a href="/the-bureau-answered/">The bureau answered? What you can do next, free</a>
          </li>
          <li><strong>Then, everything after the envelope is sealed</strong><span>Your next letter depends on the answer. The Credit Letter Kit holds them, paid once:</span>
            <ul class="compact-list">{kitMoments["credit-letter-kit"].moments.map((m) => <li>{`${m.when}: ${m.items.join(", ")}.`}</li>)}</ul>
          </li>
        </ol>
        <a class="button secondary-button" href="/pricing/#credit-letter-kit">{`See the ${creditKitLabel}`}</a>
      </div>
      <div class="recommendation-card" data-recommendation>
        <p class="eyebrow">What the kit adds</p>
        <h3>{`${kits[first.id].name} — ${kits[first.id].price}`}</h3>
        <p><strong>{kits[first.id].promise}</strong> An editable Word file and a PDF guide, paid once.</p>
        <ul class="compact-list">{kits[first.id].moments.map((m) => <li>{`${m.when}: ${m.items.join(", ")}.`}</li>)}{kits[first.id].alsoIncluded.length > 0 && <li>{`Also included: ${kits[first.id].alsoIncluded.join(", ")}.`}</li>}</ul>
        <a class="button secondary-button" href={`/pricing/#${first.recommendationSku}`}>{`See the ${kits[first.id].name} — ${kits[first.id].price}`}</a>
      </div>
      <p class="ap-selfhelp">{SELF_HELP_LINE} This free tool uses fixed templates in your browser. It is not AI and not a promise of approval.</p>
    </aside>
  </div>
</section>

<script>
  import { studioSituations, bureaus, buildLetter, situationById, BEFORE_YOU_MAIL, ANSWER_WINDOW, answerDueDate, parseDay, dayValue, buildAnswerDueIcs, formatLetterDate } from "../lib/letterStudioCore.mjs";

  const root = document.querySelector<HTMLElement>("[data-letter-studio]");
  if (root) {
    const KEY = "ap-letter-studio";
    const form = root.querySelector<HTMLFormElement>(".studio-form")!;
    const fieldsBox = root.querySelector<HTMLElement>("[data-fields]")!;
    const sheet = root.querySelector<HTMLElement>("[data-draft-output]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const actions = root.querySelector<HTMLElement>("[data-letter-actions]")!;
    const pdfButton = root.querySelector<HTMLButtonElement>("[data-save-pdf]")!;
    const shareButton = root.querySelector<HTMLButtonElement>("[data-share-draft]")!;
    const mailSteps = root.querySelector<HTMLElement>("[data-mail-steps]")!;
    const timeline = root.querySelector<HTMLElement>("[data-timeline]")!;
    const recommendation = root.querySelector<HTMLElement>("[data-recommendation]")!;
    const undo = root.querySelector<HTMLElement>("[data-undo]")!;
    const select = form.elements.namedItem("situation") as HTMLSelectElement;
    const kits = JSON.parse(root.dataset.kits || "{}");
    const START = status.textContent || "";

    type State = { situation: string; answers: Record<string, string>; drafted: boolean };
    let state: State = { situation: studioSituations[0].id, answers: {}, drafted: false };
    let letter: ReturnType<typeof buildLetter> | null = null;
    let cleared: State | null = null;
    let undoTimer = 0;

    const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch { /* private mode: the page still works */ } };
    const load = () => {
      try {
        const kept = JSON.parse(sessionStorage.getItem(KEY) || "null");
        if (kept && typeof kept === "object") state = { situation: String(kept.situation || state.situation), answers: { ...(kept.answers || {}) }, drafted: Boolean(kept.drafted) };
      } catch { /* nothing kept */ }
      const asked = new URLSearchParams(location.search).get("situation");
      if (asked && studioSituations.some((s) => s.id === asked) && !state.drafted && !Object.keys(state.answers).length) state.situation = asked;
      if (!studioSituations.some((s) => s.id === state.situation)) state.situation = studioSituations[0].id;
    };

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, string> = {}, text = "") => {
      const node = document.createElement(tag);
      for (const [k, v] of Object.entries(props)) node.setAttribute(k, v);
      if (text) node.textContent = text;
      return node;
    };

    const say = (text: string, tone = "") => { status.textContent = text; status.dataset.tone = tone; };

    const renderFields = () => {
      const situation = situationById(state.situation);
      fieldsBox.replaceChildren();
      for (const field of situation.fields) {
        const id = `studio-${field.name}`;
        const label = el("label", { for: id }, field.label + (field.optional ? " (optional)" : ""));
        let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        if (field.kind === "bureau") {
          input = el("select", { id, name: field.name });
          input.append(el("option", { value: "" }, "Choose one"));
          for (const b of bureaus) input.append(el("option", { value: b.id }, b.name));
        } else if (field.kind === "long" || field.kind === "lines") {
          input = el("textarea", { id, name: field.name, rows: field.kind === "lines" ? "2" : "4", autocomplete: field.autocomplete || "off" });
        } else {
          input = el("input", { id, name: field.name, type: "text", autocomplete: field.autocomplete || "off" });
        }
        input.value = state.answers[field.name] || "";
        label.append(input);
        if (field.hint) label.append(el("span", { class: "fine" }, field.hint));
        fieldsBox.append(label);
      }
    };

    const renderRecommendation = () => {
      const kit = kits[state.situation];
      if (!kit) return;
      const title = kit.price ? `${kit.name} — ${kit.price}` : kit.name;
      recommendation.replaceChildren(
        el("p", { class: "eyebrow" }, "What the kit adds"),
        el("h3", {}, title),
        (() => { const p = el("p"); p.append(el("strong", {}, kit.promise), document.createTextNode(" An editable Word file and a PDF guide, paid once.")); return p; })(),
        (() => { const ul = el("ul", { class: "compact-list" }); for (const m of kit.moments || []) ul.append(el("li", {}, `${m.when}: ${m.items.join(", ")}.`)); if ((kit.alsoIncluded || []).length) ul.append(el("li", {}, `Also included: ${kit.alsoIncluded.join(", ")}.`)); return ul; })(),
        el("a", { class: "button secondary-button", href: `/pricing/#${kit.sku}` }, `See the ${title}`)
      );
    };

    const renderLetter = () => {
      const situation = situationById(state.situation);
      const show = state.drafted;
      sheet.hidden = !show; actions.hidden = !show;
      pdfButton.hidden = !(show && situation.kind === "dispute");
      mailSteps.hidden = !(show && situation.kind === "dispute");
      timeline.hidden = mailSteps.hidden;
      if (!timeline.hidden) renderDue();
      recommendation.hidden = !timeline.hidden;
      shareButton.hidden = !(show && typeof navigator.share === "function");
      if (!show) { letter = null; sheet.replaceChildren(); return; }
      letter = buildLetter(state.situation, state.answers);
      sheet.replaceChildren();
      // A [bracket] is a fact still missing: mark it so it cannot be sent unnoticed.
      for (const part of letter.text.split(/(\[[^\]\n]+\])/)) {
        if (!part) continue;
        sheet.append(/^\[[^\]]+\]$/.test(part) ? el("mark", { class: "ap-hl" }, part) : document.createTextNode(part));
      }
      say(letter.blanks.length
        ? `Letter written. Still to fill in, marked in yellow: ${letter.blanks.join(", ")}.`
        : "Letter written. Read it once for anything that is not accurate, then sign it and send it yourself.", letter.blanks.length ? "todo" : "done");
    };

    // Day 30 is a date we print, worked out here in the browser. Nothing is tracked or sent.
    const mailedInput = root.querySelector<HTMLInputElement>("[data-mailed-on]")!;
    const dueLabel = root.querySelector<HTMLElement>("[data-due-date]")!;
    const mailedOn = () => parseDay(state.answers.mailedOn);
    const renderDue = () => { mailedInput.value = dayValue(mailedOn()); dueLabel.textContent = formatLetterDate(answerDueDate(mailedOn())); };
    mailedInput.addEventListener("change", () => { state.answers.mailedOn = mailedInput.value; renderDue(); save(); });
    root.querySelector("[data-add-calendar]")!.addEventListener("click", () => {
      const bureau = bureaus.find((b) => b.id === state.answers.bureau);
      download(new Blob([buildAnswerDueIcs({ mailedOn: mailedOn(), bureauName: bureau?.name || "" })], { type: "text/calendar" }), "credit-bureau-answer-due.ics");
      say(`Saved a calendar file for ${formatLetterDate(answerDueDate(mailedOn()))}. Open it to add the date to your own calendar.`, "done");
    });

    const hasAnswers = () => Object.entries(state.answers).some(([, v]) => String(v).trim());

    form.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement;
      if (!target?.name || target.name === "situation") return;
      state.answers[target.name] = target.value;
      if (state.drafted) renderLetter();
      save();
    });

    select.addEventListener("change", () => {
      const had = state.drafted;
      state.situation = select.value; state.drafted = false;
      renderFields(); renderRecommendation(); renderLetter();
      say(had ? "Situation changed. Press “Write my letter ›” for the new letter." : START);
      save();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!hasAnswers()) { say("Nothing to write yet. Answer the questions above first: the letter is built from your facts.", "stop"); status.scrollIntoView({ block: "center", behavior: "smooth" }); return; }
      state.drafted = true;
      renderLetter(); save();
      root.querySelector("#your-letter")?.scrollIntoView({ block: "start", behavior: "smooth" });
    });

    root.querySelector("[data-copy-draft]")!.addEventListener("click", async () => {
      if (!letter) return;
      try { await navigator.clipboard.writeText(letter.text); say("Copied. Paste it into an email or a document.", "done"); }
      catch { say("Your browser blocked the copy button. Press and hold the letter to select and copy it.", "stop"); }
    });

    shareButton.addEventListener("click", async () => {
      if (!letter) return;
      try { await navigator.share({ title: letter.subject, text: letter.text }); } catch { /* she closed the share sheet */ }
    });

    const download = (blob: Blob, filename: string) => {
      const link = el("a", { href: URL.createObjectURL(blob), download: filename });
      document.body.append(link); link.click(); link.remove();
      setTimeout(() => URL.revokeObjectURL(link.href), 4000);
    };

    root.querySelector("[data-download-draft]")!.addEventListener("click", () => {
      if (!letter) return;
      download(new Blob([letter.text], { type: "text/plain" }), "my-letter.txt");
      say("Saved as a text file in your downloads.", "done");
    });

    pdfButton.addEventListener("click", async () => {
      if (!letter) return;
      const { buildLetterPdf, LETTER_PDF_FOOTER } = await import("../lib/letterPdf.mjs");
      download(new Blob([buildLetterPdf(letter, { footer: LETTER_PDF_FOOTER, sheet: { title: "Before you mail", lines: BEFORE_YOU_MAIL, notes: [`If you mail this on ${formatLetterDate(mailedOn())}, the bureau\u2019s answer is due about ${formatLetterDate(answerDueDate(mailedOn()))}. Mailed on another day: add 30 days to that date.`, ANSWER_WINDOW.text + " Sources: " + ANSWER_WINDOW.source.url + " and " + ANSWER_WINDOW.law.label + ". What each answer means: approvalprep.com/the-bureau-answered/", "What the bureau decides is up to the bureau. This letter asks for an investigation; it does not promise a result."] } })], { type: "application/pdf" }), "credit-report-dispute-letter.pdf");
      say("Saved as a PDF in your downloads: your letter, then a “Before you mail” page. Print it, sign it and mail it yourself.", "done");
    });

    root.querySelector("[data-reset-studio]")!.addEventListener("click", () => {
      if (!hasAnswers() && !state.drafted) return;
      cleared = { situation: state.situation, answers: { ...state.answers }, drafted: state.drafted };
      state = { situation: state.situation, answers: {}, drafted: false };
      renderFields(); renderLetter(); say(START); save();
      undo.hidden = false;
      clearTimeout(undoTimer);
      undoTimer = window.setTimeout(() => { undo.hidden = true; cleared = null; }, 12000);
    });

    root.querySelector("[data-undo-reset]")!.addEventListener("click", () => {
      if (!cleared) return;
      state = cleared; cleared = null; undo.hidden = true; clearTimeout(undoTimer);
      renderFields(); renderRecommendation(); renderLetter(); save();
    });

    load();
    select.value = state.situation;
    renderFields(); renderRecommendation(); renderLetter();
  }
</script>

<style>
  [data-letter-studio] [hidden] { display: none !important; }
  .studio-form label { display: grid; gap: 6px; font-weight: 600; }
  .studio-form input, .studio-form textarea, .studio-form select { width: 100%; min-height: 48px; padding: 10px 12px; font: inherit; font-weight: 400; font-size: 16px; color: var(--carbon); background: #fff; border: 1px solid var(--carbon-muted); border-radius: var(--radius-md); }
  .studio-form textarea { resize: vertical; }
  .studio-form :global(label .fine) { font-weight: 400; font-size: 14px; }
  .studio-form .primary-button { width: 100%; min-height: 52px; }
  .studio-quiet { margin: 0; }
  .link-button { background: none; border: 0; padding: 12px 0; min-height: 44px; font: inherit; color: var(--signal-deep); text-decoration: underline; cursor: pointer; }
  .letter-sheet { white-space: pre-wrap; overflow-wrap: anywhere; max-width: none; margin-top: 0; padding: 20px; font-size: 15px; line-height: 1.6; color: var(--carbon); }
  .studio-status { margin: 0; font-size: 15px; color: var(--carbon); }
  .studio-status[data-tone="stop"] { color: var(--stop); font-weight: 600; }
  .studio-status[data-tone="done"] { color: var(--done); font-weight: 600; }
  .studio-preview .hero-actions { align-items: center; }
  .timeline-list { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 12px; }
  .timeline-list li { display: grid; gap: 2px; padding-left: 14px; border-left: 3px solid var(--highlighter); }
  .timeline-list span { font-size: 15px; }
  .timeline-list .compact-list { margin: 6px 0 0; padding-left: 18px; list-style: disc; }
  .timeline-list .compact-list li { display: list-item; border-left: 0; padding-left: 0; }
  .mailed-on { display: grid; gap: 6px; font-weight: 600; max-width: 220px; margin: 6px 0; }
  .mailed-on input { min-height: 48px; padding: 8px 10px; font: inherit; font-size: 16px; border: 1px solid var(--carbon-muted); border-radius: var(--radius-md); background: #fff; }
  .timeline-list a { min-height: 44px; display: inline-flex; align-items: center; }
</style>
