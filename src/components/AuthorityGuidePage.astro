---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQBlock from "./FAQBlock.astro";
import RelatedContent from "./RelatedContent.astro";
import TrustAndBoundaryBand from "./TrustAndBoundaryBand.astro";
import RecommendationSummary from "./RecommendationSummary.astro";
import LetterGenerator from "./LetterGenerator.astro";
import { articleSchema, breadcrumbSchema, faqSchema, howToSchema, itemListSchema, canonicalUrl, productSchema, internalHref } from "../lib/schema";
import { isDeadOutbound } from "../lib/outbound";
import { productForSku } from "../data/content";
const { page }=Astro.props;
// The canonical was built here by string concatenation and so named the
// no-trailing-slash form, which Cloudflare Pages 308-redirects. BaseLayout
// normalises the <link rel="canonical">, but the JSON-LD `url` it is also used
// for is emitted verbatim - so the structured data pointed every one of these
// pages at a redirect. canonicalUrl() is the single source of truth for the
// published URL form (src/lib/schema.ts); nothing here rebuilds it by hand.
const canonical=canonicalUrl(page.path);
const product=page.sku?productForSku(page.sku):null;
const schema=[
  articleSchema({title:page.title,description:page.description,url:canonical,datePublished:page.datePublished||"2026-07-30"}),
  breadcrumbSchema(page.path),
  faqSchema(page.faq),
  howToSchema({name:`How to prepare ${page.title}`,steps:page.steps}),
  itemListSchema({name:`${page.title} fields`,items:page.fields}),
  ...(product?[productSchema({name:product.name,description:product.customer_situation||page.description,url:canonicalUrl("/pricing"),price:product.priceLabel})]:[])
];
---
<BaseLayout title={`${page.title} - ApprovalPrep`} description={page.description} canonical={canonical} schema={schema}>
<section class="hero shell hero-split"><div><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.description}</p><div class="hero-actions">{page.sku&&product?(<button class="button primary-button checkout-button" type="button" data-sku={page.sku}>{`Buy the ${product.name} — ${product.priceLabel}`}</button>):(<a class="button primary-button" href={internalHref(page.primaryHref)}>{page.primaryCta}</a>)}<a class="button secondary secondary-button" href={internalHref(page.secondaryHref)}>{page.secondaryCta}</a>{page.generator&&<a class="button secondary secondary-button" href="#generator">Jump to the free generator</a>}</div></div><RecommendationSummary variant="panel" headline="Prepare facts a reviewer can verify." statement={page.summary} /></section>
{page.definition&&(
<section class="band"><div class="shell"><article class="card citation-definition" data-content-block="definition_callout"><p class="eyebrow">{page.definitionLabel||"Definition"}</p><p><strong>{page.definition}</strong></p>{page.definitionDetail&&<p>{page.definitionDetail}</p>}</article></div></section>
)}
{page.generator&&<LetterGenerator generator={page.generator} sku={page.sku||""} skuLabel={product?.name||""} skuPrice={product?.priceLabel||""} />}
<section class="band"><div class="shell two"><article><p class="eyebrow">Key facts</p><h2>Know the boundary before drafting.</h2><ul class="compact-list">{page.keyFacts.map((x)=><li>{x}</li>)}</ul></article><article class="card"><p class="eyebrow">Fields to collect</p><h2>Build the factual record.</h2><ul class="compact-list">{page.fields.map((x)=><li>{x}</li>)}</ul></article></div></section>
<section class="band"><div class="shell"><p class="eyebrow">Exact sequence</p><h2>Prepare it step by step.</h2><ol class="steps-list">{page.steps.map((x,i)=><li><strong>{i+1}.</strong> {x}</li>)}</ol></div></section>
{page.comparison&&(
<section class="band"><div class="shell"><p class="eyebrow">Decision table</p><h2>{page.comparison.heading}</h2><p class="lead">{page.comparison.intro}</p><div class="table-wrap"><table class="comparison-table"><thead><tr>{page.comparison.columns.map((c)=><th>{c}</th>)}</tr></thead><tbody>{page.comparison.rows.map((row)=><tr>{row.map((cell)=><td>{cell}</td>)}</tr>)}</tbody></table></div></div></section>
)}
<section class="band"><div class="shell two"><article class="card template-card"><p class="eyebrow">Copyable template</p><h2>{page.templateTitle}</h2><pre>{page.template}</pre></article><article class="card template-card"><p class="eyebrow">Second tool</p><h2>{page.alternateTitle}</h2><pre>{page.alternateTemplate}</pre></article></div></section>
{page.examples&&(
<section class="band"><div class="shell"><p class="eyebrow">Worked examples</p><h2>{page.examplesHeading||"Filled-in samples you can compare against."}</h2><p class="lead">{page.examplesIntro||"Each sample below is complete rather than a skeleton. The names, dates and amounts are invented for illustration; replace every one of them with your own verifiable facts."}</p><div class="example-stack">{page.examples.map((example)=>(<article class="card template-card"><h3>{example.label}</h3><p>{example.context}</p><pre>{example.body}</pre>{example.why&&<p class="fine"><strong>Why this one works:</strong> {example.why}</p>}</article>))}</div></div></section>
)}
<section class="band"><div class="shell two"><article><p class="eyebrow">Avoid</p><h2>Common mistakes</h2><ul class="compact-list">{page.mistakes.map((x)=><li>{x}</li>)}</ul></article><article class="notice"><strong>Self-service boundary</strong><p>{page.boundary}</p></article></div></section>
<section class="band"><div class="shell"><p class="eyebrow">Primary sources</p><h2>Check the current instructions.</h2><div class="grid">{page.sources.map((s)=>isDeadOutbound(s.url)?(<div class="card"><h3>{s.label}</h3><p>Source withdrawn by its publisher since this page was reviewed. Search the publisher's site for the current version.</p></div>):(<a class="card" href={internalHref(s.url)} rel="noopener noreferrer"><h3>{s.label}</h3><p>Open official or primary source →</p></a>))}</div></div></section>
<FAQBlock title={`${page.title} questions`} faq={page.faq}/>
{page.sku&&product&&(
<section class="band cta-callout"><div class="shell"><p class="eyebrow">Next step</p><h2>{`Keep the editable version: ${product.name}.`}</h2><p class="lead">{product.customer_situation}</p><p>Everything on this page is free to use and copy. The kit is the paid, downloadable version at {product.priceLabel}, paid once: a PDF guide plus editable DOCX files you keep, covering {product.included_offerings.length} named documents including {product.included_offerings.slice(0,3).join(", ")}.</p><div class="hero-actions"><button class="button primary-button checkout-button" type="button" data-sku={page.sku}>{`Buy the ${product.name} — ${product.priceLabel}`}</button><a class="button secondary secondary-button" href="/pricing/">Compare all kits</a></div></div></section>
)}
<RelatedContent path={page.path}/><TrustAndBoundaryBand/>
<style>.template-card pre{white-space:pre-wrap;font-family:inherit;line-height:1.65;background:var(--surface-muted,#f5f3ef);padding:1rem;border-radius:.75rem;overflow:auto}.steps-list{display:grid;gap:.8rem;padding:0;list-style:none}.steps-list li{padding:1rem;border:1px solid rgba(0,0,0,.12);border-radius:.75rem}.example-stack{display:grid;gap:1.25rem}</style>
</BaseLayout>
