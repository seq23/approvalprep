---
import { internalHref } from "../lib/schema";
const { primary = "Open the free Studio", secondary = "Compare paid kits", sku = "", primaryHref = "/letter-writing-studio", secondaryHref = "/pricing", freeFirst = false } = Astro.props;
---
<div class="page-cta-stack">
  {freeFirst && sku ? (
    <>
      <a class="button primary-button" href={secondaryHref}>{secondary}</a>
      <button class="button secondary-button checkout-button" type="button" data-sku={sku}>{primary}</button>
    </>
  ) : (
    <>
      {sku ? <button class="button primary-button checkout-button" type="button" data-sku={sku}>{primary}</button> : <a class="button primary-button" href={internalHref(primaryHref)}>{primary}</a>}
      <a class="button secondary-button" href={internalHref(secondaryHref)}>{secondary}</a>
    </>
  )}
</div>
