---
// The free employment verification letter (launch kit, 21 Nov 2026; the top low-competition search,
// 18,100 a month). The checklist and the letter frame open on this page the moment the address is in;
// the same content is emailed once the address is confirmed (double opt-in), then one email that
// helps and one that sells (functions/_runtime/nurture.js employmentSequence, ev0-ev2).
import { EMPLOYMENT_CHECKLIST as STARTER_CHECKLIST, EMPLOYMENT_CONSENT_TEXT as STARTER_CONSENT_TEXT, EMPLOYMENT_LETTER as STARTER_LETTER } from "../../functions/_runtime/nurture.js";
const SELF_HELP_LINE = "Self-help templates. Not legal or financial advice.";
interface Props { inline?: boolean }
const { inline = false } = Astro.props;
---
<section class={inline ? "starter-inline" : "band starter-band"} data-employment-signup id="free-employment-letter"><div class={inline ? "" : "shell"}>
  <div class="card sample-signup starter-signup">
    <p class="eyebrow">Free · takes a minute</p>
    <h2>Free employment verification letter</h2>
    <p>A short checklist and <span class="ap-hl">a letter frame your employer fills in</span> on letterhead, for a landlord, lender or agency that asked you to prove your job.</p>
    <form data-starter-form novalidate>
      <label>Email address
        <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
      </label>
      <input type="text" name="company" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
      <label class="sample-consent"><input type="checkbox" name="consent" /> <span>{STARTER_CONSENT_TEXT}</span></label>
      <p class="fine" role="alert" data-starter-error></p>
      <button class="button primary-button" type="submit">Email me the free letter ›</button>
      <p class="fine">It opens here as soon as you press the button. Every email has a one-click unsubscribe link. See the <a href="/privacy/">privacy page</a>.</p>
    </form>
    <div data-starter-done hidden>
      <p class="notice" role="status" data-starter-sent>Here is your letter. To get a copy by email, press <strong>Confirm my email</strong> in the email we just sent.</p>
      <p class="notice warning-card" role="alert" data-starter-unsent hidden>Here is your letter. The confirm email did not send yet; we will try again shortly. Save or print this page in the meantime.</p>
      <ol class="compact-list">{STARTER_CHECKLIST.map((line) => <li>{line}</li>)}</ol>
      <h3>The letter</h3>
      <p class="fine">Your employer fills in each bracket, prints it on company letterhead and signs it. Self-employed? Send tax returns, 1099s or bank statements instead; the free Letter Studio drafts a letter that explains them.</p>
      <div class="ap-sheet">{STARTER_LETTER.map((line) => <p>{line}</p>)}</div>
      <div class="hero-actions"><a class="button primary-button" href="/letter-writing-studio/">Draft free in the Letter Studio</a><a class="button secondary secondary-button" href="/pricing/">See the Income + Employment Letter Kit</a></div>
    </div>
    <p class="ap-selfhelp">{SELF_HELP_LINE}</p>
  </div>
</div></section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-employment-signup]")) {
    const form = root.querySelector<HTMLFormElement>("[data-starter-form]");
    const error = root.querySelector<HTMLElement>("[data-starter-error]");
    const done = root.querySelector<HTMLElement>("[data-starter-done]");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (error) error.textContent = "";
      if (!data.get("consent")) { if (error) error.textContent = "Please tick the box so we can email the letter."; return; }
      try {
        const res = await fetch("/api/sample", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ email: data.get("email"), consent: true, magnet: "employment-letter", company: data.get("company") || undefined }) });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.ok) { if (error) error.textContent = body.error || "Something went wrong. Please try again."; return; }
        form.hidden = true; if (done) done.hidden = false;
        if (body.emailed !== true) { root.querySelector<HTMLElement>("[data-starter-sent]")?.setAttribute("hidden", ""); root.querySelector<HTMLElement>("[data-starter-unsent]")?.removeAttribute("hidden"); }
      } catch { if (error) error.textContent = "Could not reach the server. Please try again."; }
    });
  }
</script>
