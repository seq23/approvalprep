---
// A free item by email, shown on the page the moment the address is in (the email asks to confirm
// first: double opt-in, functions/_runtime/nurture.js). Two uses, one component:
// - the free credit starter (her yes, 7 Nov 2026: "1A yes"), "Before you pay a credit repair company";
//   self-help only (risk R-ADV-13): no score, removal or "fix your credit" promise;
// - the free employment verification letter (launch kit, 21 Nov 2026; the top low-competition
//   search, 18,100 a month), via kind="employment".
import { EMPLOYMENT_CHECKLIST, EMPLOYMENT_CONSENT_TEXT, EMPLOYMENT_LETTER, EMPLOYMENT_PLAIN, STARTER_CHECKLIST, STARTER_CONSENT_TEXT, STARTER_LETTER, SELF_HELP_LINE } from "../../functions/_runtime/nurture.js";
interface Props { inline?: boolean; kind?: "credit" | "employment" }
const { inline = false, kind = "credit" } = Astro.props;
const c = kind === "employment" ? {
  id: "free-employment-letter", magnet: "employment-letter", noun: "letter", heading: "Free employment verification letter",
  intro: "A short checklist and a letter frame your employer fills in on letterhead, for a landlord, lender or agency that asked you to prove your job.",
  consent: EMPLOYMENT_CONSENT_TEXT, checklist: EMPLOYMENT_CHECKLIST, letter: EMPLOYMENT_LETTER, letterHeading: "The letter",
  letterNote: "Your employer fills in each bracket, prints it on company letterhead and signs it. Self-employed? Send tax returns, 1099s or bank statements instead; the free Letter Studio drafts a letter that explains them.",
  actions: [["Draft free in the Letter Studio", "/letter-writing-studio/"], ["See the Income + Employment Letter Kit", "/pricing/#income-employment-letter-kit"]], selfHelp: EMPLOYMENT_PLAIN
} : {
  id: "free-credit-starter", magnet: "credit-starter", noun: "starter", heading: "Before you pay a credit repair company",
  intro: "A 1-page checklist of what you can do yourself for $0, plus one dispute letter frame for one error on your report.",
  consent: STARTER_CONSENT_TEXT, checklist: STARTER_CHECKLIST, letter: STARTER_LETTER, letterHeading: "Your dispute letter",
  letterNote: "Fill in each bracket with your true facts, or let the free Letter Studio fill it in and save it as a PDF.",
  actions: [["Draft free in the Letter Studio", "/letter-writing-studio/?situation=credit-dispute"], ["See the Credit Letter Kit", "/credit-letter-kit/"]], selfHelp: SELF_HELP_LINE
};
// What the page says after the button, by what really happened (functions/api/sample.js `state`).
const said = {
  confirm_sent: `Here is your ${c.noun}. To get a copy by email, press Confirm my email in the email we just sent.`,
  confirm_pending: `Here is your ${c.noun}. We already sent you a confirm email; press Confirm my email in it to get a copy.`,
  already_subscribed: `Here is your ${c.noun}. This address is already on our list, so there is nothing to confirm.`,
  opted_out: `Here is your ${c.noun}. This address unsubscribed earlier, so we will not email it. Save or print this page.`,
  not_sent: `Here is your ${c.noun}. The confirm email did not send yet; we will try again shortly. Save or print this page in the meantime.`
};
---
<section class={inline ? "starter-inline" : "band starter-band"} data-starter-signup data-magnet={c.magnet} data-said={JSON.stringify(said)} id={c.id}><div class={inline ? "" : "shell"}>
  <div class="card sample-signup starter-signup">
    <p class="eyebrow">Free · takes a minute</p>
    <h2>{c.heading}</h2>
    <p>{c.intro}</p>
    <form data-starter-form novalidate>
      <label>Email address
        <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
      </label>
      <input type="text" name="company" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
      <label class="sample-consent"><input type="checkbox" name="consent" /> <span>{c.consent}</span></label>
      <p class="fine" role="alert" data-starter-error></p>
      <button class="button primary-button" type="submit">{`Email me the free ${c.noun} ›`}</button>
      <p class="fine">It opens here as soon as you press the button. Every email has a one-click unsubscribe link. See the <a href="/privacy/">privacy page</a>.</p>
    </form>
    <div data-starter-done hidden>
      <p class="notice" role="status" data-starter-said></p>
      <ol class="compact-list">{c.checklist.map((line) => <li>{line}</li>)}</ol>
      <h3>{c.letterHeading}</h3>
      <p class="fine">{c.letterNote}</p>
      <div class="ap-sheet">{c.letter.map((line) => <p>{line}</p>)}</div>
      <div class="hero-actions">{c.actions.map(([label, href], i) => <a class={i === 0 ? "button primary-button" : "button secondary secondary-button"} href={href}>{label}</a>)}</div>
    </div>
    <p class="ap-selfhelp">{c.selfHelp}</p>
  </div>
</div></section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-starter-signup]")) {
    const form = root.querySelector<HTMLFormElement>("[data-starter-form]");
    const error = root.querySelector<HTMLElement>("[data-starter-error]");
    const done = root.querySelector<HTMLElement>("[data-starter-done]");
    const said = JSON.parse(root.dataset.said || "{}");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (error) error.textContent = "";
      if (!data.get("consent")) { if (error) error.textContent = "Please tick the box so we can email it to you."; return; }
      try {
        const res = await fetch("/api/sample", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ email: data.get("email"), consent: true, magnet: root.dataset.magnet, company: data.get("company") || undefined }) });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.ok) { if (error) error.textContent = body.error || "Something went wrong. Please try again."; return; }
        form.hidden = true; if (done) done.hidden = false;
        const line = root.querySelector<HTMLElement>("[data-starter-said]");
        if (line) { line.textContent = said[body.state] || said.not_sent; if (body.state === "not_sent" || body.state === "opted_out") line.classList.add("warning-card"); }
      } catch { if (error) error.textContent = "Could not reach the server. Please try again."; }
    });
  }
</script>
