---
/**
 * The offerings bundled into one product, one card each.
 *
 * THE BOUNDARY IS RENDERED ONCE, NOT ONCE PER CARD. Every offering in
 * data/products/full_offering_catalog.json carries the same riskBoundary
 * sentence (all 105 of them, verified 3 Nov 2026), so printing it under each
 * card repeated one sentence nine times on /letter-of-explanation/ and tripped
 * the Search Readiness template-filler test, which fails a page on any 8-word
 * phrase that appears more than three times. The sentence still has to be on
 * the page - it is the safety boundary, not decoration - so it moves to the
 * foot of the section, where it covers every card once. Distinct boundaries,
 * should the catalog ever carry them, are each shown once.
 */
const { product, offerings = [] } = Astro.props;
const boundaries = [...new Set(offerings.map((offering) => offering?.riskBoundary).filter(Boolean))];
---
{product && offerings.length > 0 && (
  <section class="band"><div class="shell">
    <p class="eyebrow">Included offerings</p>
    <h2>{product.name || product.product_name} includes these self-service tools.</h2>
    <div class="offering-list cards">
      {offerings.map((offering) => (
        <article class="card offering-item">
          <h3>{offering.name || offering}</h3>
          {offering.customerSituation && <p>{offering.customerSituation}</p>}
        </article>
      ))}
    </div>
    {boundaries.map((boundary) => <p class="fine">{boundary}</p>)}
  </div></section>
)}
