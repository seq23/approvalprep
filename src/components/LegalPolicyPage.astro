---
import DataPrivacyNotice from "./DataPrivacyNotice.astro";
import BoundaryNotice from "./BoundaryNotice.astro";

const { route, copy } = Astro.props;
const effectiveDate = "July 8, 2026";
const legalPolicies = {
  "/privacy": {
    summary: "ApprovalPrep does not ask users to create accounts for public self-service tools and does not store letter answers, completed drafts, uploaded documents, or personal application packets.",
    covers: [
      "What information may be processed to operate checkout, downloads, support, security, and analytics.",
      "What ApprovalPrep intentionally does not store: customer letter answers, completed drafts, uploaded documents, or private application packets.",
      "How payment and download verification rely on service providers without turning ApprovalPrep into a document-storage product.",
      "Free sample emails: if you type your address to get the free sample, we store that address and the wording you agreed to, send the sample through Resend, and send up to four short emails, at most one every three days, stopping when you buy or unsubscribe. Every email has a one-click unsubscribe link; opt-outs are kept as a one-way hash so we never email you again.",
      "After a purchase: the address Stripe reports is not stored by ApprovalPrep. It is used once to schedule one email, about three days later, asking whether the kit helped, and a one-way hash of it stops the sample emails. Replies are only ever shown with your permission."
    ],
    limits: [
      "Stripe (payments), Cloudflare (hosting), Resend (email) and Microsoft Clarity (analytics) may process limited operational records under their own terms.",
      "Microsoft Clarity records how visitors move through pages that have a sign-up form or a buy button (clicks, scrolling, the page viewed) and sets its own cookies (_clck, _clsk). It is switched off on the Letter Writing Studio and on every page with a free letter generator, so what you type there and the letter it makes are never recorded.",
      "The Letter Writing Studio keeps your draft in your own browser tab so a reload does not lose it. It is not sent to ApprovalPrep and is gone when you close the tab or press Start over.",
      "Do not send sensitive documents by email unless you choose to do so and understand the risk.",
      "No website can promise perfect security, but ApprovalPrep keeps the public product designed around minimal data collection."
    ]
  },
  "/terms": {
    summary: "ApprovalPrep is a self-service document-prep website. By using it, users agree to use truthful information, review their own materials, and send documents themselves.",
    covers: [
      "Permitted use of templates, guides, checklists, downloadable files, and the free Letter Writing Studio.",
      "User responsibility for accuracy, legality, completeness, review, submission, and final decisions.",
      "Site boundaries: no professional advice, no credit repair service, no third-party contact, no fake documents, and no approval guarantee."
    ],
    limits: [
      "ApprovalPrep materials are educational and self-service only.",
      "Users should get qualified professional help for legal, tax, credit, lending, immigration, court, or regulated issues.",
      "ApprovalPrep may update products, policies, pages, and downloadable materials over time."
    ]
  },
  "/disclaimer": {
    summary: "ApprovalPrep helps users organize truthful facts and self-service paperwork. It does not provide legal, financial, lending, credit repair, tax, or professional advice.",
    covers: [
      "No attorney-client, advisor-client, lender, broker, credit repair, or representative relationship is created.",
      "Templates and examples are starting points for the user to review and customize.",
      "ApprovalPrep does not promise approval, deletion, acceptance, funding, housing, employment, or any third-party outcome."
    ],
    limits: [
      "Do not use ApprovalPrep to create false statements, fake documents, misleading proof, threats, or impersonation.",
      "Regulated disputes and legal deadlines may require a qualified professional.",
      "Users are responsible for deciding whether a template is appropriate for their facts."
    ]
  },
  "/refund-policy": {
    summary: "Every kit is a digital download that unlocks as soon as you pay. We refund a purchase when something went wrong with the charge or the download. Once a kit has downloaded correctly it is not returnable, unless the law where you live says otherwise.",
    covers: [
      "We refund: a duplicate purchase, a wrong charge, or a kit that did not unlock or download and that we cannot get working for you.",
      "How to ask: email info@approvalprep.com from the address you paid with. Include your Stripe receipt (or the date and amount) and one line on what went wrong.",
      "What happens next: we first try to get your download working. If we cannot, or the charge was a mistake, the refund goes back to the card you paid with through Stripe.",
      "We do not refund: a kit that downloaded correctly, including when a landlord, lender, employer, bureau or creditor did not give the answer you hoped for."
    ],
    limits: [
      "ApprovalPrep does not guarantee a third party will accept a packet or approve an application.",
      "Dissatisfaction with an external outcome is not the same as a product delivery failure.",
      "This policy does not limit rights that cannot be waived under applicable consumer law."
    ]
  },
  "/security": {
    summary: "ApprovalPrep is designed around minimal data collection, protected paid downloads, and operational controls that reduce unnecessary exposure of customer document contents.",
    covers: [
      "Checkout, download verification, admin access, provider configuration, and release validation boundaries.",
      "The public no-storage promise for letter answers, completed drafts, uploads, and personal application packets.",
      "Operational records needed for payment, delivery, security, support, and site reliability."
    ],
    limits: [
      "Users should avoid sending sensitive documents by email unless they choose that channel.",
      "Security depends on provider configuration, environment variables, deployment settings, and ongoing monitoring.",
      "ApprovalPrep cannot control third-party websites or institutions after a user sends materials."
    ]
  },
  "/accessibility": {
    summary: "ApprovalPrep aims to keep public pages, checkout paths, and self-service guidance readable, navigable, and usable across common devices.",
    covers: [
      "Plain-language content, visible links, keyboard-friendly controls, readable contrast, and responsive layouts.",
      "Continued improvement when accessibility issues are found.",
      "A contact path for users who need help accessing information."
    ],
    limits: [
      "Some third-party checkout, email, analytics, or provider interfaces are controlled by their providers.",
      "Accessibility work is ongoing and should be validated as the site changes.",
      "Users can contact info@approvalprep.com for access issues or alternate support needs."
    ]
  },
  "/editorial-policy": {
    summary: "ApprovalPrep content should be plain, useful, truthful, and bounded. It should help users prepare without overstating outcomes or drifting into professional advice.",
    covers: [
      "How guides, blog answers, glossary pages, product pages, and policy pages should stay practical.",
      "Review expectations for credit-sensitive, legal-sensitive, financial, lending, tax, or regulated topics.",
      "The rule that content should route users to a useful next step, not a dead-end article."
    ],
    limits: [
      "Generated or drafted content should not be treated as automatically approved for public use.",
      "ApprovalPrep should not publish fake expertise, fake evidence, or guaranteed outcome claims.",
      "Content can explain preparation steps but should point users to qualified help when facts are complex."
    ]
  },
  "/ai-use-policy": {
    summary: "ApprovalPrep may use software-assisted workflows to organize public content and operations, but customer-facing self-service tools must stay truthful, bounded, and reviewable.",
    covers: [
      "Use of generated drafts, validation checks, publishing queues, and admin tooling.",
      "Rules against fake claims, fake documents, legal advice, credit repair promises, or fabricated proof.",
      "The free Letter Writing Studio is browser-only static logic and does not require paid AI calls or customer document storage."
    ],
    limits: [
      "AI-assisted output should be reviewed before sensitive public publication.",
      "Automation does not replace legal, compliance, editorial, security, or owner judgment.",
      "ApprovalPrep should not claim live rankings, citations, or telemetry that has not been observed."
    ]
  },
  // The public version of the defense record in the spry brain ("ApprovalPrep: how we stay outside
  // credit-repair law"), her ask 13 Nov 2026: answer first, the law as the reader's own rights, our
  // safeguards, the free path, then not legal advice. The internal limits and notes stay in the brain.
  "/credit-repair-disclaimer": {
    effectiveDate: "November 13, 2026",
    summary: "ApprovalPrep is not a credit repair company. We sell self-help dispute letter templates: you fill in your own true facts, then sign and mail every letter yourself.",
    welcome: "Looking for a cheaper, easier, fairer alternative to a credit repair company? You’re in the right place: do it yourself with our letters, paid once, no monthly fee.",
    sections: [
      {
        heading: "The law on credit repair companies, in plain words",
        paragraphs: [
          "The federal Credit Repair Organizations Act (15 U.S.C. 1679 to 1679j) covers anyone who, for payment, performs a service to improve your credit record, history or rating. If you ever hire a credit repair company, these are your rights:"
        ],
        items: [
          "It may not charge you anything until it has fully done the work it promised.",
          "It must give you a written contract that spells out the services, the total cost, how long it will take and any result it guarantees.",
          "You have three business days to cancel without paying anything, and it must give you a cancellation form.",
          "Before you sign, it must give you a written statement of your rights, including that you can dispute errors yourself for free.",
          "It may not lie about what it can do. No one can legally remove accurate, current information from your credit report."
        ],
        links: [
          { href: "https://consumer.ftc.gov/articles/fixing-your-credit-faqs", label: "FTC: Fixing your credit FAQs" },
          { href: "https://www.consumerfinance.gov/ask-cfpb/what-is-a-credit-repair-company-en-1343/", label: "CFPB: What is a credit repair company?" },
          { href: "https://www.consumerfinance.gov/ask-cfpb/what-are-my-rights-if-i-hire-a-credit-repair-company-en-1345/", label: "CFPB: Your rights if you hire a credit repair company" }
        ]
      },
      {
        heading: "Why ApprovalPrep is a product, not a service",
        paragraphs: ["You buy a finished set of templates and get it at once. We do not do the work for you. These are the safeguards we keep:"],
        items: [
          "We never act for you. We never mail anything, contact a credit bureau, creditor, landlord, lender or employer, read your credit report, or follow up on a dispute.",
          "We never promise a result. We do not say we will raise a score, remove an item, fix or repair your credit, or get you approved.",
          "Paid once, delivered at once. You pay one price and get the files right after paying, so you never pay ahead for future work.",
          "No monthly fee and no per-round, per-letter or per-bureau charge. One kit covers every later letter, and coming back is never a new charge.",
          "In the phone app, the mailing date and the day-30 reminder live only on your own phone. We never see them or act on them.",
          "The free path comes first: a free credit bureau dispute letter and a free Letter Studio draft.",
          "Accurate information stays on a report. A letter is a request, not a promise.",
          "We hold no customer documents. We do not keep your answers, finished letters or uploads; only payment and download records.",
          "True facts only. The templates are for your real facts, and we never make fake documents."
        ]
      },
      {
        heading: "Disputing an error is free",
        paragraphs: [
          "You can dispute a mistake on your credit report yourself, at no cost, directly with the credit bureaus and with the business that reported it. The bureau must look into it. You can get your free credit reports at AnnualCreditReport.com."
        ],
        links: [
          { href: "https://www.consumerfinance.gov/ask-cfpb/how-do-i-dispute-an-error-on-my-credit-report-en-314/", label: "CFPB: How to dispute an error on your credit report" },
          { href: "https://www.annualcreditreport.com/", label: "AnnualCreditReport.com" },
          { href: "/letter-writing-studio/", label: "Draft a dispute letter free in the Letter Studio" }
        ]
      },
      {
        heading: "Not legal advice",
        paragraphs: [
          "This page is general information, not legal or financial advice. Self-help templates. Not legal or financial advice. We do not contact bureaus or creditors for you. Questions: info@approvalprep.com."
        ]
      }
    ],
    covers: [],
    limits: []
  },
  "/not-a-credit-repair-company": {
    summary: "ApprovalPrep does not perform credit repair. It provides self-service organization tools for users who choose to prepare and send their own materials.",
    covers: [
      "No third-party credit repair services, no bureau contact, no creditor contact, and no dispute submission by ApprovalPrep.",
      "No promise that a record will be removed, changed, suppressed, or improved.",
      "A clear separation between self-service preparation materials and regulated credit repair services."
    ],
    limits: [
      "Users remain responsible for the truthfulness and suitability of anything they send.",
      "ApprovalPrep cannot control how credit bureaus, creditors, collectors, lenders, or landlords respond.",
      "Professional advice may be needed for complex credit, legal, identity theft, bankruptcy, or debt matters."
    ]
  }
};

const policy = legalPolicies[route.path] || {
  summary: copy.shortAnswer,
  covers: copy.whatYouGet || [],
  limits: copy.commonMistakes || []
};
---
<section class="band legal-policy-band">
  <div class="shell legal-policy-layout">
    <aside class="legal-policy-meta card">
      <p class="eyebrow">Policy page</p>
      <p><strong>Effective:</strong> {policy.effectiveDate || effectiveDate}</p>
      {/*
        email_off / email_on are Cloudflare's documented opt-out from Email Address Obfuscation.
        Without them the zone rewrites every address on this page into a link to
        /cdn-cgi/l/email-protection - AND THAT PATH RETURNS 404. A visitor with JavaScript gets the
        address back from the decoder; a crawler, and anyone without JS, gets a dead link where the
        only support contact should be. Ahrefs counts it as the site's 404 page, its 4XX page, and
        a page linking to a broken page, on every legal surface at once.
      */}
      <p><strong>Contact:</strong> <!--email_off--><a href="mailto:info@approvalprep.com">info@approvalprep.com</a><!--email_on--></p>
      <p class="fine">This page is general information about ApprovalPrep’s site and services. It is not legal advice.</p>
    </aside>
    <article class="legal-policy-body">
      <p class="eyebrow">Plain-English summary</p>
      <h2>{route.title}</h2>
      <p class="lead">{policy.summary}</p>
      {policy.welcome && <p class="supporting-copy ap-alt-line"><strong>{policy.welcome}</strong></p>}
      {(policy.sections || []).map((section) => (
        <section class="card legal-policy-section">
          <h3>{section.heading}</h3>
          <!--email_off-->{(section.paragraphs || []).map((text) => <p>{text}</p>)}<!--email_on-->
          {section.items?.length > 0 && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          {section.links?.length > 0 && <ul class="compact-list">{section.links.map((link) => <li><a href={link.href} rel={link.href.startsWith("http") ? "noopener" : undefined}>{link.label}</a></li>)}</ul>}
        </section>
      ))}
      {(policy.covers.length > 0 || policy.limits.length > 0) && <div class="legal-policy-grid">
        <div class="card">
          <h3>What this covers</h3>
          <ul><!--email_off-->{policy.covers.map((item) => <li>{item}</li>)}<!--email_on--></ul>
        </div>
        <div class="card warning-card">
          <h3>Important limits</h3>
          <ul><!--email_off-->{policy.limits.map((item) => <li>{item}</li>)}<!--email_on--></ul>
        </div>
      </div>}
      <DataPrivacyNotice />
      <BoundaryNotice />
      <div class="legal-links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/credit-repair-disclaimer/">Why we’re not a credit repair company</a>
        <a href="/refund-policy/">Refund policy</a>
        <a href="/contact/">Contact</a>
      </div>
    </article>
  </div>
</section>
