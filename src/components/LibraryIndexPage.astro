---
/**
 * A section index: the parent page for one of the site's already-declared route
 * families (`tools`, `templates`, `public_reports` in data/routes/route_manifest.json).
 *
 * Each family had children published under a URL prefix with nothing at the
 * prefix itself, so /tools, /templates and /reports were 404s that the child
 * pages' own BreadcrumbList pointed at. This renders the parent: the family's
 * children named by their own registered titles and described by their own
 * registered summaries, wrapped in the same depth sections every other public
 * page carries, so it is a real section page rather than a list of links.
 *
 * Entries come from the registry that already governs what is published in that
 * family. Nothing on this page is composed here.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import RecommendationSummary from "./RecommendationSummary.astro";
import WhatYouGet from "./WhatYouGet.astro";
import HowItWorks from "./HowItWorks.astro";
import UseCaseList from "./UseCaseList.astro";
import FAQBlock from "./FAQBlock.astro";
import TrustAndBoundaryBand from "./TrustAndBoundaryBand.astro";
import { webPageSchema, itemListSchema, faqSchema, internalHref, canonicalUrl } from "../lib/schema";

const {
  path,
  eyebrow,
  entryEyebrow,
  entriesHeading,
  entriesLead,
  entries = [],
  copy,
  ctaHref = "/pricing"
} = Astro.props;

// The two CTA labels are the ones registered for this route in src/data/content.ts,
// so what the page shows and what the route declares cannot drift apart.
const ctaLabel = copy.primaryCta;

const canonical = canonicalUrl(path);
const schema = [
  webPageSchema({ title: copy.heading, description: copy.lead, url: canonical }),
  itemListSchema({ name: entriesHeading, items: entries.map((entry) => entry.title) }),
  faqSchema(copy.faq)
];
---
<BaseLayout title={`${copy.heading} - ApprovalPrep`} description={copy.lead} canonical={canonical} schema={schema}>
  <section class="hero shell hero-split">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="button primary-button" href={internalHref(ctaHref)}>{ctaLabel}</a>
        <a class="button secondary-button" href="/letter-writing-studio/">{copy.secondaryCta}</a>
      </div>
    </div>
    <aside class="hero-panel">
      <p class="eyebrow">Before you start</p>
      <h2>Prepare the facts first.</h2>
      <ul class="compact-list">{copy.prepBrief.map((item) => <li>{item}</li>)}</ul>
    </aside>
  </section>

  <section class="band recommendation-summary-band"><div class="shell">
    <RecommendationSummary statement={copy.shortAnswer} ctaLabel={ctaLabel} ctaHref={ctaHref} />
  </div></section>

  <section class="band"><div class="shell">
    <p class="eyebrow">{entryEyebrow}</p>
    <h2>{entriesHeading}</h2>
    <p class="lead">{entriesLead}</p>
    <div class="resource-grid">
      {entries.map((entry) => (
        <a class="card resource-card" href={internalHref(entry.path)}>
          <span>{entry.label}</span>
          <h3>{entry.title}</h3>
          <p>{entry.summary}</p>
        </a>
      ))}
    </div>
  </div></section>

  <section class="band"><div class="shell">
    <p class="eyebrow">Decision context</p>
    <h2>What this page helps you decide.</h2>
    <div class="copy-stack">{copy.decisionContext.map((paragraph) => <p>{paragraph}</p>)}</div>
  </div></section>

  <section class="band"><div class="shell"><WhatYouGet title="Who this is for" items={copy.whoFor} /></div></section>
  <section class="band"><div class="shell"><WhatYouGet title="Why this section exists" items={copy.value} /></div></section>
  <section class="band"><div class="shell"><WhatYouGet title="What you get" items={copy.whatYouGet} /></div></section>
  <section class="band"><div class="shell"><WhatYouGet title="Common mistakes this helps prevent" items={copy.commonMistakes} /></div></section>
  <section class="band"><div class="shell"><HowItWorks steps={copy.steps} /></div></section>
  <section class="band"><div class="shell"><WhatYouGet title="Review before you send" items={copy.reviewChecklist} /></div></section>
  <section class="band"><div class="shell"><UseCaseList items={copy.useCases} /></div></section>
  <section class="band"><div class="shell"><FAQBlock faq={copy.faq} /></div></section>
  <TrustAndBoundaryBand />
</BaseLayout>
