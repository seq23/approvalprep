{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "internal": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "simulator": {
      "distribution": "internal",
      "channel": "simulator",
      "environment": "production",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834891489",
        "appleTeamId": "34LUUUDT4H"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./play-sa.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
